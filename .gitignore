# Environment / secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Generated native projects (Expo prebuild) — regenerate with `expo prebuild`
apps/mobile/ios/
apps/mobile/android/

# OS cruft
.DS_Store
Thumbs.db

# Firebase CLI debug output
firestore-debug.log
*-debug.log

# Local Claude Code settings (machine-specific permissions, not shared config)
.claude/settings.local.json

# Locally-installed skills (reproducible from skills-lock.json)
.agents/
.claude/skills/
apps/mobile/.claude/skills/
